<!doctype html>
<html lang="id">
<head>
  <meta content="text/html; charset=utf-8" http-equiv="Content-Type" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Notifikasi Perubahan Password - SIAPI</title>
</head>
<body style="margin:0; padding:0; background-color:#f0f4f0; font-family:'Segoe UI', Arial, sans-serif;">

  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f0f4f0; padding:40px 0;">
    <tr>
      <td align="center">
        <table width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px; width:100%;">

          <!-- HEADER LOGO -->
          <tr>
            <td align="center" style="padding-bottom:24px;">
              {{#if logo_url}}
              <img src="{{logo_url}}" alt="SIAPI Kemenag" width="160" style="display:block; max-width:160px; height:auto;" />
              {{else}}
              <div style="font-size:22px; font-weight:700; color:#006633; letter-spacing:1px;">SIAPI</div>
              {{/if}}
            </td>
          </tr>

          <!-- CARD -->
          <tr>
            <td style="background-color:#ffffff; border-radius:12px; box-shadow:0 4px 20px rgba(0,0,0,0.08); overflow:hidden;">

              <!-- TOP ACCENT BAR -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="background-color:#006633; height:6px; border-radius:12px 12px 0 0;"></td>
                </tr>
              </table>

              <!-- BODY -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="padding:40px 48px 32px;">

                    <!-- Icon -->
                    <table width="100%" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td align="center" style="padding-bottom:24px;">
                          <div style="display:inline-block; background-color:#e6f2ec; border-radius:50%; width:68px; height:68px; line-height:68px; text-align:center; font-size:32px;">
                            ✅
                          </div>
                        </td>
                      </tr>
                    </table>

                    <!-- Title -->
                    <p style="margin:0 0 8px; font-size:22px; font-weight:700; color:#1a2e1a; text-align:center;">
                      Password Berhasil Diubah
                    </p>
                    <p style="margin:0 0 28px; font-size:15px; color:#5a6b5a; text-align:center; line-height:1.7;">
                      Halo, <strong>{{ user.fullname }}</strong>.<br/>
                      Password akun SIAPI Anda telah berhasil diperbarui.
                    </p>

                    <!-- Success Info Box -->
                    <table width="100%" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td style="background-color:#e6f2ec; border:1px solid #99ccb3; border-radius:8px; padding:20px 24px;">
                          <p style="margin:0 0 6px; font-size:13px; color:#006633; font-weight:700;">
                            ✔&nbsp; Perubahan password berhasil tercatat
                          </p>
                          <p style="margin:0; font-size:13px; color:#1a6b3a; line-height:1.7;">
                            Password Anda akan kedaluwarsa setelah <strong>90 hari</strong>. Sistem akan mengingatkan Anda secara otomatis untuk mengganti password demi menjaga keamanan akun.
                          </p>
                        </td>
                      </tr>
                    </table>

                    <!-- Danger Warning Box -->
                    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top:20px;">
                      <tr>
                        <td style="background-color:#fff0f0; border-left:4px solid #cc3333; border-radius:4px; padding:14px 18px;">
                          <p style="margin:0; font-size:13px; color:#992222; line-height:1.7;">
                            ⚠&nbsp; Jika Anda <strong>tidak merasa melakukan perubahan</strong> ini, segera hubungi administrator sistem atau tim IT instansi Anda.
                          </p>
                        </td>
                      </tr>
                    </table>

                    <p style="margin:28px 0 0; font-size:13px; color:#9aaa9a; text-align:center; line-height:1.7;">
                      Demi keamanan, jangan pernah membagikan password Anda kepada siapapun.
                    </p>

                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <!-- FOOTER -->
          <tr>
            <td style="padding:24px 0 0; text-align:center;">
              <p style="margin:0; font-size:12px; color:#8a9a8a; line-height:1.9;">
                Email ini dikirim secara otomatis oleh sistem, mohon jangan membalas email ini.<br/>
                <strong style="color:#006633;">Sistem Informasi Pengawasan Internal</strong><br/>
                Kementerian Agama Republik Indonesia
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>

</body>
</html>
