{
  "name": "service-email",
  "version": "1.0.0",
  "description": "Centralized email service for SIAPI",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "dev": "nodemon ./bin/www",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo:all",
    "test": "jest --forceExit --detectOpenHandles"
  },
  "dependencies": {
    "bullmq": "^5.4.2",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "debug": "~2.6.9",
    "dotenv": "^16.0.3",
    "express": "~4.16.1",
    "express-validator": "^7.0.1",
    "handlebars": "^4.7.8",
    "http-errors": "~1.6.3",
    "ioredis": "^5.3.2",
    "morgan": "~1.9.1",
    "nodemailer": "^6.9.4",
    "pg": "^8.10.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.32.1",
    "sequelize-cli": "^6.6.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^2.0.22",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/*.test.js"],
    "forceExit": true
  }
}
